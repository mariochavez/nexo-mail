{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#4c4f69",
    "margin": 2
  },
  "block_quote": {
    "color": "#6c6f85",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#8839ef",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#eff1f5",
    "background_color": "#8839ef",
    "bold": true
  },
  "h2": {
    "prefix": "▌ ",
    "color": "#1e66f5",
    "bold": true
  },
  "h3": {
    "prefix": "▌ ",
    "color": "#179299",
    "bold": true
  },
  "h4": {
    "prefix": "▌ ",
    "color": "#40a02b",
    "bold": true
  },
  "h5": {
    "prefix": "▌ ",
    "color": "#df8e1d",
    "bold": true
  },
  "h6": {
    "prefix": "▌ ",
    "color": "#fe640b",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "color": "#ea76cb",
    "italic": true
  },
  "strong": {
    "color": "#fe640b",
    "bold": true
  },
  "hr": {
    "color": "#acb0be",
    "format": "\n─────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#1e66f5",
    "underline": true
  },
  "link_text": {
    "color": "#7287fd",
    "bold": true
  },
  "image": {
    "color": "#1e66f5",
    "underline": true
  },
  "image_text": {
    "color": "#6c6f85",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#40a02b",
    "background_color": "#ccd0da"
  },
  "code_block": {
    "color": "#4c4f69",
    "margin": 2
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  }
}
