#!/usr/bin/env ruby
# frozen_string_literal: true

# nexo-triage — triage Apple Mail + Gmail + HEY in one run and write a unified
# inbox-digest.md into ./sandbox, with a styled terminal UI (Charm for Ruby).
#
# Prerequisites (one-time; any that aren't ready are skipped, not fatal):
#   * apple-mail-mcp on PATH (indexed)
#   * Gmail:  export GMAIL_ADDRESS + GMAIL_APP_PASSWORD  (read-only IMAP)
#   * HEY:    hey auth login
#   * LLM_API_KEY exported (for glm-5.2:cloud via Ollama Cloud) + `ollama signin`
#
#   exe/nexo-triage
#   exe/nexo-triage --help           # how to configure every service
#   exe/nexo-triage --check          # preflight: which services are ready
#   RUBYLLM_WIRE=1 exe/nexo-triage   # show the raw ruby_llm/MCP logs (debugging)
require_relative "../config/environment"
require "io/console"
require "optparse"
require "lipgloss"
require "glamour"

# --- Styles: Catppuccin Mocha -----------------------------------------------
# https://catppuccin.com/palette (Mocha)
MOCHA = {
  mauve: "#cba6f7", green: "#a6e3a1", red: "#f38ba8", peach: "#fab387",
  overlay1: "#7f849c", base: "#1e1e2e", text: "#cdd6f4"
}.freeze

# The Glamour markdown theme (Catppuccin Mocha), loaded from config/.
MOCHA_STYLE = JSON.parse(File.read(File.expand_path("../config/catppuccin_mocha.json", __dir__)))

module UI
  module_function

  def header = Lipgloss::Style.new.bold(true).foreground(MOCHA[:base]).background(MOCHA[:mauve]).padding(0, 2)
  def brand  = Lipgloss::Style.new.foreground(MOCHA[:mauve]).bold(true)
  def dim    = Lipgloss::Style.new.foreground(MOCHA[:overlay1])
  def ok     = Lipgloss::Style.new.foreground(MOCHA[:green]).bold(true)
  def bad    = Lipgloss::Style.new.foreground(MOCHA[:red]).bold(true)

  def term_width = (IO.console&.winsize&.last || 80)

  def clock(seconds) = format("%02d:%02d", (seconds / 60).to_i, (seconds % 60).to_i)

  def duration(ms)
    ms = ms.to_i
    ms < 1000 ? "#{ms}ms" : format("%.1fs", ms / 1000.0)
  end
end

SPINNER = %w[⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏].freeze

# --- Help & preflight -------------------------------------------------------
def section(title) = puts("\n#{UI.brand.render(title)}")
def line(text) = puts("  #{text}")
def note(text) = puts("  #{UI.dim.render(text)}")

def print_help
  puts UI.header.render("Nexo Mail Agent")
  note "Triage Apple Mail, Gmail & HEY into one prioritized digest. Read-only."

  section "USAGE"
  line "exe/nexo-triage [options]"

  section "OPTIONS"
  line "-h, --help    Show this help and how to configure each service"
  line "    --check   Preflight only: report which services are configured"

  section "MODEL (required) — Ollama, OpenAI-compatible"
  line "Default model is glm-5.2:cloud (Ollama Cloud). Sign in and set the key:"
  line "  ollama signin"
  line "  export LLM_API_KEY=<ollama-cloud-key>"
  note "Override: LLM_MODEL (e.g. llama3.1 for a local pull), LLM_API_BASE"
  note "(default http://localhost:11434/v1)."

  section "APPLE MAIL — apple-mail-mcp (local MCP server)"
  line "pipx install apple-mail-mcp"
  line "Grant Full Disk Access to your terminal (System Settings → Privacy)."
  line "apple-mail-mcp init            # writes ~/.apple-mail-mcp/config.toml"
  line "apple-mail-mcp index --verbose # build the search index (re-run to refresh)"
  note "Override the launch command with MAIL_MCP_COMMAND."

  section "GMAIL — read-only IMAP with an App Password (no gcloud)"
  line "1. Enable 2-Step Verification on the Google account."
  line "2. Create an App Password: https://myaccount.google.com/apppasswords"
  line "3. export GMAIL_ADDRESS='you@gmail.com'"
  line "   export GMAIL_APP_PASSWORD='xxxx xxxx xxxx xxxx'"

  section "HEY — the Basecamp hey CLI"
  line "Install (Go 1.26+):"
  line "  git clone https://github.com/basecamp/hey-cli && cd hey-cli && go install ./cmd/..."
  line "  # ensure $(go env GOPATH)/bin is on PATH"
  line "Authenticate:  hey auth login"

  section "NOTES"
  note "Any service that isn't installed/authenticated is skipped automatically —"
  note "the run continues with whatever's available. Use --check to preview."
  note "RUBYLLM_WIRE=1 shows the raw ruby_llm/MCP logs for debugging."
  puts
  exit 0
end

def print_check
  puts UI.header.render("Nexo Mail Agent — preflight")
  key = ENV["LLM_API_KEY"].to_s.empty? ? UI.bad.render("LLM_API_KEY not set") : UI.ok.render("ready")
  puts "\n  #{UI.brand.render("Model".ljust(11))} #{key}"
  MultiInboxTriage::SOURCES.each do |name, (klass, _)|
    reason = klass.availability
    status = reason ? "#{UI.bad.render("⊘")} #{UI.dim.render(reason)}" : UI.ok.render("✓ ready")
    puts "  #{UI.brand.render(name.ljust(11))} #{status}"
  end
  puts
  exit 0
end

OptionParser.new do |o|
  o.on("-h", "--help") { print_help }
  o.on("--check") { print_check }
end.parse!(ARGV)

puts
puts UI.header.render("Nexo Mail Agent — Apple Mail · Gmail · HEY")
puts

# --- Run the workflow in the background; animate a spinner + clock -----------
started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
result = nil
error = nil
worker = Thread.new do
  result = MultiInboxTriage.run
rescue => e
  error = e
end

frame = 0
while worker.alive?
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
  print "\r#{UI.brand.render(SPINNER[frame % SPINNER.size])} " \
        "Triaging inboxes…  #{UI.dim.render("elapsed #{UI.clock(elapsed)}")}   "
  $stdout.flush
  frame += 1
  sleep 0.1
end
worker.join
print "\r\e[K" # clear the spinner line

if error
  puts UI.bad.render("✗ Run failed: #{error.class}: #{error.message}")
  raise error
end

run = result
total = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started

# --- Per-source outcome, read back from the workflow event log --------------
results = {}
Nexo::Workflow.logs(run.id) do |ev|
  d = ev["data"] || {}
  case ev["type"]
  when "source_done"    then results[d["source"]] = {state: :ok, ms: d["ms"]}
  when "source_failed"  then results[d["source"]] = {state: :failed, ms: d["ms"], detail: d["error"]}
  when "source_skipped" then results[d["source"]] = {state: :skipped, detail: d["reason"]}
  end
end

MultiInboxTriage::SOURCES.each_key do |name|
  r = results[name] || {state: :unknown}
  label = UI.brand.render(name.ljust(11))
  case r[:state]
  when :ok
    puts "  #{UI.ok.render("✓")} #{label} #{UI.dim.render(UI.duration(r[:ms]))}"
  when :failed
    puts "  #{UI.bad.render("✗")} #{label} #{UI.dim.render(UI.duration(r[:ms]))}  " \
         "#{UI.bad.render("failed: #{r[:detail].to_s[0, 60]}")}"
  when :skipped
    puts "  #{UI.dim.render("⊘")} #{label} #{UI.dim.render("skipped — #{r[:detail]}")}"
  else
    puts "  #{UI.dim.render("• #{name} — no result")}"
  end
end
puts "  #{UI.dim.render("─" * 24)}"
puts "  #{UI.brand.render("total".ljust(13))}#{UI.dim.render(UI.clock(total))}"

# --- Render the unified digest with Glamour ---------------------------------
art = run.artifacts.find { |a| (a["name"] || a[:name]) == "inbox-digest.md" }
digest = art && (art["content"] || art[:content])

puts
if digest && !digest.strip.empty?
  puts Glamour.render_with_style(digest, MOCHA_STYLE, width: [UI.term_width, 100].min)
  puts UI.dim.render("Saved to #{File.join(SANDBOX_DIR, "inbox-digest.md")}")
else
  puts UI.bad.render("No digest produced (run status: #{run.status}).")
end
