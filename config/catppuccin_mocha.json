{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#cdd6f4", "margin": 2 },
  "block_quote": { "color": "#a6adc8", "italic": true, "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#cba6f7", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#1e1e2e", "background_color": "#cba6f7", "bold": true },
  "h2": { "prefix": "▌ ", "color": "#89b4fa", "bold": true },
  "h3": { "prefix": "▌ ", "color": "#94e2d5", "bold": true },
  "h4": { "prefix": "▌ ", "color": "#a6e3a1", "bold": true },
  "h5": { "prefix": "▌ ", "color": "#f9e2af", "bold": true },
  "h6": { "prefix": "▌ ", "color": "#fab387", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#f5c2e7", "italic": true },
  "strong": { "color": "#fab387", "bold": true },
  "hr": { "color": "#585b70", "format": "\n─────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#89b4fa", "underline": true },
  "link_text": { "color": "#b4befe", "bold": true },
  "image": { "color": "#89b4fa", "underline": true },
  "image_text": { "color": "#a6adc8", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#a6e3a1", "background_color": "#313244" },
  "code_block": { "color": "#cdd6f4", "margin": 2 },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " }
}
